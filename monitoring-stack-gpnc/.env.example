# --- Component Versions ---
GRAFANA_VERSION=12.0.0
PROMETHEUS_VERSION=v2.42.0
CADVISOR_VERSION=v0.46.0
NODE_EXPORTER_VERSION=v1.5.0
ALERTMANAGER_VERSION=v0.25.0
REDIS_VERSION=6

# --- Domain Configuration ---
GRAFANA_ROOT_URL=https://monitoring.yourdomain.com/
GRAFANA_DOMAIN=monitoring.yourdomain.com

# --- Resource Limits ---
MONITORING_CPUS=0.5
MONITORING_MEM_LIMIT=512m

# --- Timezone ---
TIMEZONE=Europe/Madrid

# --- Security: Port Binding (Optional) ---
# By default, ports are exposed to the network (e.g., 3000).
# If you are using a reverse proxy (like Nginx Proxy Manager), uncomment 
# the following lines to bind ports ONLY to localhost for security:
# GRAFANA_PORT=127.0.0.1:3000
# PROMETHEUS_PORT=127.0.0.1:9090
# ALERTMANAGER_PORT=127.0.0.1:9093
# ALERT_RECEIVER_PORT=127.0.0.1:9094
# REDIS_PORT=127.0.0.1:6379
# LOKI_PORT=127.0.0.1:3100
