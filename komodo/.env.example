# ==========================================
# KOMODO CONFIGURATION
# ==========================================

# --- Image Versions ---
KOMODO_VERSION=latest
MONGO_VERSION=6.0

# --- Ports & Security Binding ---
# Expose to reverse proxy (recommended localhost binding):
KOMODO_PORT=127.0.0.1:9120
# Or expose directly to the local network:
# KOMODO_PORT=9120

# --- Authentication & Secrets ---
# Generate strong secrets (e.g. openssl rand -hex 32)
KOMODO_JWT_SECRET=replace_with_a_secure_jwt_secret
KOMODO_PASSKEY=replace_with_a_secure_periphery_passkey
KOMODO_FIRST_SERVER=true
