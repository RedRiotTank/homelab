# =========================================
# 1. IGNORE ALL BY DEFAULT
# =========================================
*
.*

# =========================================
# 2. GLOBAL ALLOWANCES (Root Level)
# =========================================
!.gitignore
!README.md
!.env.example

# =========================================
# 3. GLOBAL EXCLUSIONS (Safety Net)
# =========================================
# Garantiza que estos archivos nunca se suban,
# incluso si se permite un directorio entero.
.env
.env.*
docker-compose.override.yml
*.log
*.sql
*.tar
*.tar.gz
*.rclone*
rclone.conf
*.key
*.crt
*.pem

# =========================================
# 4. ALLOW-LISTED SERVICES
# =========================================

# --- Backup Manager ---
!backup-manager/
backup-manager/*
!backup-manager/Dockerfile
!backup-manager/docker-compose.yml
!backup-manager/*.md
!backup-manager/*.sh
!backup-manager/.env.example

# --- Nextcloud ---
!nextcloud/
nextcloud/*
!nextcloud/docker-compose.yml
!nextcloud/*.md
!nextcloud/.env.example

# --- AppFlowy ---
!appflowy/
appflowy/*
!appflowy/docker-compose.yml
!appflowy/nginx/
!appflowy/*.md
!appflowy/.env.example

# --- Homarr ---
!homarr/
homarr/*
!homarr/docker-compose.yml
!homarr/*.md
!homarr/.env.example

# --- Jellyfin ---
!jellyfin/
jellyfin/*
!jellyfin/docker-compose.yml
!jellyfin/*.md
!jellyfin/.env.example
