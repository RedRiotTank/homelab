# =========================================
# 1. IGNORE ALL BY DEFAULT
# =========================================
*
.*

# =========================================
# 2. GLOBAL ALLOWANCES (Root Level)
# =========================================
!.gitignore
!README.md
!.env.example

# =========================================
# 3. GLOBAL EXCLUSIONS (Safety Net)
# =========================================
.env
.env.*
docker-compose.override.yml
*.log
*.sql
*.tar
*.tar.gz
*.rclone*
rclone.conf
*.key
*.crt
*.pem

# =========================================
# 4. ALLOW-LISTED SERVICES
# =========================================

# --- Monitoring Stack ---
!monitoring-stack-gpnc/
monitoring-stack-gpnc/*
!monitoring-stack-gpnc/docker-compose.yml
!monitoring-stack-gpnc/*.md
!monitoring-stack-gpnc/.env.example
!monitoring-stack-gpnc/LICENSE
!monitoring-stack-gpnc/Makefile
!monitoring-stack-gpnc/configs/**
!monitoring-stack-gpnc/dashboards/**

# --- Backup Manager ---
!backup-manager/
backup-manager/*
!backup-manager/Dockerfile
!backup-manager/docker-compose.yml
!backup-manager/*.md
!backup-manager/*.sh
!backup-manager/*.json
!backup-manager/.env.example
!backup-manager/disaster-recovery/
backup-manager/disaster-recovery/*
!backup-manager/disaster-recovery/*.sh
!backup-manager/disaster-recovery/*.md

# --- Nextcloud ---
!nextcloud/
nextcloud/*
!nextcloud/docker-compose.yml
!nextcloud/*.md
!nextcloud/.env.example

# --- AppFlowy ---
!appflowy/
appflowy/*
!appflowy/docker-compose.yml
!appflowy/nginx/
!appflowy/*.md
!appflowy/.env.example

# --- Homarr ---
!homarr/
homarr/*
!homarr/docker-compose.yml
!homarr/*.md
!homarr/.env.example

# --- Jellyfin ---
!jellyfin/
jellyfin/*
!jellyfin/docker-compose.yml
!jellyfin/*.md
!jellyfin/.env.example

# --- RomM (Retro) ---
!romm/
romm/*
!romm/docker-compose.yml
!romm/*.md
!romm/.env.example

# --- Bookshelf ---
!bookshelf/
bookshelf/*
!bookshelf/docker-compose.yml
!bookshelf/*.md
!bookshelf/.env.example

# --- Arr Stack ---
!arr-stack/
arr-stack/*
!arr-stack/docker-compose.yml
!arr-stack/*.md
!arr-stack/.env.example
!arr-stack/*.sh
!arr-stack/kitsunarr_src/**

# --- Reverse Proxy (Traefik / Nginx Proxy Manager) ---
!proxy-stack/
proxy-stack/*
!proxy-stack/docker-compose.yml
!proxy-stack/*.md
!proxy-stack/.env.example
!proxy-stack/dynamic/**

# --- AdGuard Home ---
!adguard/
adguard/*
!adguard/docker-compose.yml
!adguard/*.md
!adguard/.env.example

# --- Komodo ---
!komodo/
komodo/*
!komodo/docker-compose.yml
!komodo/*.md
!komodo/.env.example
