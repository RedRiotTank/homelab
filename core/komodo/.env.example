# ==========================================
# KOMODO CONFIGURATION
# ==========================================

# --- Image Versions ---
KOMODO_VERSION=latest
MONGO_VERSION=6.0

# --- Ports (Solo si se descomenta ports en compose o vía override) ---
# Binding recomendado en localhost para bootstrap:
KOMODO_PORT=127.0.0.1:9120
# Exposición directa a toda la interfaz del host:
# KOMODO_PORT=9120

# --- Host Path Mounts ---
# Ruta raíz en el host donde residen los stacks y datos
HOST_STACKS_PATH=/opt
CONTAINER_STACKS_PATH=/opt

# --- Authentication & Secrets ---
# Generar claves con: openssl rand -hex 32
KOMODO_JWT_SECRET=replace_with_a_secure_jwt_secret
KOMODO_PASSKEY=replace_with_a_secure_periphery_passkey

# Setear en false en nodos satélite/secundarios (ej. CrimsonServer)
KOMODO_FIRST_SERVER=true
