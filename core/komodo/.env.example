# ==========================================
# KOMODO CONFIGURATION
# ==========================================

# --- Image Versions ---
KOMODO_VERSION=latest
MONGO_VERSION=6.0

# --- Ports (only if ports are uncommented in compose or the override) ---
# Recommended: bind to localhost for bootstrap access.
KOMODO_PORT=127.0.0.1:9120
# Expose directly on every host interface:
# KOMODO_PORT=9120

# --- Host Path Mounts ---
# Root path on the host where stacks and their data live.
HOST_STACKS_PATH=/opt
CONTAINER_STACKS_PATH=/opt

# --- Authentication & Secrets ---
# Generate with: openssl rand -hex 32
KOMODO_JWT_SECRET=replace_with_a_secure_jwt_secret
KOMODO_PASSKEY=replace_with_a_secure_periphery_passkey

# Set to false on satellite/secondary nodes.
KOMODO_FIRST_SERVER=true
