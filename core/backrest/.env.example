# ==============================================================================
# Backrest Service Configuration (Portable Template)
# ==============================================================================

# Web UI port binding (recommended: 127.0.0.1:9898 to expose only via reverse proxy)
BACKREST_PORT=127.0.0.1:9898

# System timezone
TZ=UTC

# Host path containing rclone.conf (for cloud storage providers: S3, B2, GDrive, etc.)
# Defaults to standard user configuration directory
HOST_RCLONE_CONFIG_DIR=~/.config/rclone

# Host path to the homelab / infrastructure Git repository
HOST_HOMELAB_DIR=~/homelab

# Host paths used by the collect-config.sh hook (home and host configuration)
HOST_HOME_DIR=/home/deployer
HOST_ETC_DIR=/etc

# Backup source paths (mounted read-only into Backrest)
HOST_DOCKER_VOLUMES_DIR=/var/lib/docker/volumes
HOST_OPT_DIR=/opt
HOST_SRV_DIR=/srv

# Local or external storage destination for Restic repositories (mounted read-write)
# WARNING: Point this to a dedicated backup partition or directory (e.g. /var/backups/restic or an external mount)
# to avoid recursively backing up the repository itself.
BACKREST_REPO_DIR=/mnt/external_backups

# Optional: Host Docker socket path (enables pre/post snapshot hooks to pause DB containers)
DOCKER_SOCKET_PATH=/var/run/docker.sock

# --- Backrest exporter (for Prometheus and the Telegram bot) ---
# Create a dedicated Backrest API user and set its password here. This file is
# git-ignored; never commit the real password.
BACKREST_EXPORTER_USER=prometheus
BACKREST_EXPORTER_PASSWORD=change-me
# Alert when the last successful backup is older than this (36 hours).
BACKREST_STALE_SECONDS=129600
BACKREST_REFRESH_SECONDS=60

# --- Monthly restore verification ---
# Host directory used as scratch space for restores. Must be outside every
# backup source; it needs roughly 40 GiB free for a Core + HeavyData drill.
HOST_BACKREST_VERIFY_SCRATCH_DIR=/var/tmp/backrest-verify
BACKREST_VERIFY_ENABLED=true
BACKREST_VERIFY_DAY=16
BACKREST_VERIFY_HOUR=4
BACKREST_VERIFY_MINUTE=0
BACKREST_VERIFY_TIMEZONE=Europe/Madrid
BACKREST_VERIFY_REMOTE_ROTATION=GDrive-RedServer,miixzify
BACKREST_VERIFY_READ_DATA_PERCENT=10
BACKREST_VERIFY_MIN_FREE_GB=40
BACKREST_VERIFY_MAX_SNAPSHOT_AGE_HOURS=36
BACKREST_VERIFY_HEAVY_PATHS=/backup/srv/nextcloud_data,/backup/opt/minecraft_servers,/backup/docker_volumes/appflowy_minio_data
BACKREST_VERIFY_MAX_RETRIES=3
BACKREST_VERIFY_RETRY_HOURS=24
BACKREST_VERIFY_KEEP_REPORTS=12
BACKREST_VERIFY_PORT=9798
