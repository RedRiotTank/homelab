# ==============================================================================
# Backrest Service Configuration (Portable Template)
# ==============================================================================

# Web UI port binding (recommended: 127.0.0.1:9898 to expose only via reverse proxy)
BACKREST_PORT=127.0.0.1:9898

# System timezone
TZ=UTC

# Host path containing rclone.conf (for cloud storage providers: S3, B2, GDrive, etc.)
# Defaults to standard user configuration directory
HOST_RCLONE_CONFIG_DIR=~/.config/rclone

# Host path to the homelab / infrastructure Git repository
HOST_HOMELAB_DIR=~/homelab

# Backup source paths (mounted read-only into Backrest)
HOST_DOCKER_VOLUMES_DIR=/var/lib/docker/volumes
HOST_OPT_DIR=/opt
HOST_SRV_DIR=/srv

# Local or external storage destination for Restic repositories (mounted read-write)
# WARNING: Point this to a dedicated backup partition or directory (e.g. /var/backups/restic or an external mount)
# to avoid recursively backing up the repository itself.
BACKREST_REPO_DIR=/mnt/external_backups

# Optional: Host Docker socket path (enables pre/post snapshot hooks to pause DB containers)
DOCKER_SOCKET_PATH=/var/run/docker.sock
