# ==========================================
# VAULTWARDEN CONFIGURATION
# ==========================================

# --- Domain & Core Settings ---
# Full HTTPS URL Vaultwarden is reached at (through the reverse proxy). Required
# for correct icon downloads, email links, and WebAuthn/Passkey registration.
VAULTWARDEN_DOMAIN=https://vault.yourdomain.com

# Disable public signups once your accounts exist (recommended for security).
SIGNUPS_ALLOWED=false

# --- Security: Admin Panel Token ---
# Protects the /admin diagnostics & user-management panel.
# Generate with: openssl rand -base64 48
ADMIN_TOKEN=changeme

# --- Networking ---
# Web UI / API port binding (recommended: 127.0.0.1:8083 to expose only via reverse proxy)
VAULTWARDEN_PORT=127.0.0.1:8083

# --- Storage ---
# Host path for persistent Vaultwarden data (SQLite DB, attachments, RSA keys)
VAULTWARDEN_DATA_DIR=./vw-data

# --- System ---
TZ=Europe/Madrid
