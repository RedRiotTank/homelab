# ==========================================
# KOMODO PERIPHERY (SECONDARY NODE AGENT)
# ==========================================

KOMODO_VERSION=latest

# Network Binding
PERIPHERY_BIND_IP=0.0.0.0
PERIPHERY_PORT=8120

# Host Paths
HOST_STACKS_PATH=/opt
CONTAINER_STACKS_PATH=/opt

# Must match the KOMODO_PASSKEY configured on the Core server 
KOMODO_PASSKEY=replace_with_a_secure_periphery_passkey
