# ==========================================
# CLOUDFLARE DDNS CONFIGURATION
# ==========================================
CF_API_TOKEN=replace_with_cloudflare_api_token
CF_ZONE=example.com
CF_PROXIED=false
CF_CRON=*/5 * * * *

# ==========================================
# NGINX PROXY MANAGER PORTS
# ==========================================
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
NPM_ADMIN_PORT=81
