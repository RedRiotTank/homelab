# ==========================================
# CLOUDFLARE DDNS CONFIGURATION
# ==========================================
CF_API_TOKEN=your_cloudflare_api_token_here
CF_ZONE=example.com
CF_PROXIED=false
CF_CRON=*/5 * * * *

# ==========================================
# NGINX PROXY MANAGER PORTS & PATHS
# ==========================================
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
NPM_ADMIN_PORT=127.0.0.1:81

NPM_DATA_PATH=/opt/compose/proxy-stack/data
NPM_LETSENCRYPT_PATH=/opt/compose/proxy-stack/letsencrypt
