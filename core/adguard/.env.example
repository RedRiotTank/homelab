# ==========================================
# ADGUARD HOME CONFIGURATION
# ==========================================

# --- Network Services (Must remain open to the LAN) ---
ADGUARD_DNS_PORT=53

# --- Security: Web UI Port Binding ---
ADGUARD_SETUP_PORT=127.0.0.1:3030
ADGUARD_WEB_PORT=127.0.0.1:8053

# --- Host Storage Paths ---
ADGUARD_WORK_PATH=/opt/core/adguard/work
ADGUARD_CONF_PATH=/opt/core/adguard/conf
