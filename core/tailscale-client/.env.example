# ==========================================
# TAILSCALE CLIENT CONFIGURATION
# ==========================================

NODE_HOSTNAME=replace_with_server_name
HEADSCALE_URL=https://vpn.yourdomain.com
HEADSCALE_AUTHKEY=replace_with_auth_key

# Optional
CONTAINER_NAME=tailscale
TAILSCALE_VERSION=stable
TAILSCALE_EXTRA_ARGS=
TAILSCALE_ACCEPT_DNS=true
