# --- Component Versions ---
GRAFANA_VERSION=12.0.0
PROMETHEUS_VERSION=v2.42.0
CADVISOR_VERSION=v0.55.1
NODE_EXPORTER_VERSION=v1.5.0
ALERTMANAGER_VERSION=v0.25.0
REDIS_VERSION=6

# --- Domain Configuration ---
GRAFANA_ROOT_URL=https://monitoring.yourdomain.com/
GRAFANA_DOMAIN=monitoring.yourdomain.com

# --- Resource Limits ---
MONITORING_CPUS=0.5
# Applied to every service in the stack.
MONITORING_MEM_LIMIT=512m
# Prometheus needs more headroom than the other components for its TSDB.
PROMETHEUS_MEM_LIMIT=1g

# Timezone used by the Telegram bot for displayed backup times.
TIMEZONE=UTC

# --- Port binding ---
# Bind management ports to loopback when the stack runs behind a reverse
# proxy. Change to 0.0.0.0:<port> only if you intentionally expose them.
GRAFANA_PORT=127.0.0.1:3000
PROMETHEUS_PORT=127.0.0.1:9090
ALERTMANAGER_PORT=127.0.0.1:9093
ALERT_RECEIVER_PORT=127.0.0.1:9094
REDIS_PORT=127.0.0.1:6379
# Loki must be reachable by remote Promtail agents. Restrict it with firewall
# rules or a private network instead of binding it to loopback unless all
# agents run on this host.
LOKI_PORT=3100

# --- External data volumes (create before first deploy) ---
GRAFANA_DATA_VOLUME=monitoring-stack-gpnc_grafana-data
PROMETHEUS_DATA_VOLUME=monitoring-stack-gpnc_prometheus-data
LOKI_DATA_VOLUME=monitoring-stack-gpnc_loki-data

# --- Alertmanager ---
# Config file mounted at /etc/alertmanager/config.yml. Point this at a private
# file (outside the repo or a *.local.yml file) when using Telegram/email
# credentials. The default is the local webhook receiver.
ALERTMANAGER_CONFIG_FILE=./configs/alertmanager/alertmanager-fallback-config.yml

# Optional read-only Telegram query bot (compose profile: telegram-bot).
# Enable it with COMPOSE_PROFILES=telegram-bot. It reuses the bot token and
# default chat ID from ALERTMANAGER_CONFIG_FILE.
#TELEGRAM_ALLOWED_CHAT_IDS=
# Map node labels to display names, e.g. primary:<primary-host>,edge-node:<edge-host>
#NODE_DISPLAY_NAMES=
#PROMETHEUS_URL=http://prometheus:9090
#BACKREST_STATUS_URL=http://backrest-exporter:9797/status
#TELEGRAM_API_URL=https://api.telegram.org
#TELEGRAM_POLL_TIMEOUT=50
#COMPOSE_PROFILES=telegram-bot

# --- Prometheus remote targets ---
# Directory mounted at /etc/prometheus/targets. It may point outside the repo
# so private hostnames/IPs are not stored in Git. Copy node-exporter.yml.example
# and cadvisor.yml.example to node-exporter.yml and cadvisor.yml.
PROMETHEUS_TARGETS_DIR=./configs/prometheus/targets
