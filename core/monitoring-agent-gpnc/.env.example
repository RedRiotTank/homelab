# ==========================================
# MONITORING AGENT
# ==========================================

# Name that identifies this node in container names and telemetry labels.
NODE_HOSTNAME=agent

# Push endpoint of the central Loki, reached over the VPN mesh.
# Replace with the primary node's Tailscale/Headscale IP.
LOKI_URL=http://100.64.0.10:3100/loki/api/v1/push

CADVISOR_VERSION=v0.46.0
NODE_EXPORTER_VERSION=v1.5.0
PROMTAIL_VERSION=3.5.0

CADVISOR_PORT=8080
NODE_EXPORTER_PORT=9100

AGENT_CPUS=0.5
AGENT_MEM_LIMIT=256m
