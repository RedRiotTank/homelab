# ==========================================
# MONITORING AGENT
# ==========================================

# Name that identifies this node in container names and telemetry labels.
NODE_HOSTNAME=agent

# Push endpoint of the central Loki.
# Replace with an address reachable from this node over your private network.
LOKI_URL=http://<loki-host>:3100/loki/api/v1/push

NODE_EXPORTER_VERSION=v1.5.0
CADVISOR_VERSION=v0.46.0
PROMTAIL_VERSION=3.5.0

CADVISOR_PORT=8080
NODE_EXPORTER_PORT=9100

AGENT_CPUS=0.5
AGENT_MEM_LIMIT=256m
