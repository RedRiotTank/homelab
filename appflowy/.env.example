# =============================================================================
# AppFlowy Cloud - Deployment Configuration Template
# =============================================================================

# Domain Configuration
FQDN=localhost
SCHEME=http
WS_SCHEME=ws

APPFLOWY_BASE_URL=http://localhost
APPFLOWY_WEBSOCKET_BASE_URL=ws://localhost/ws/v2

# =============================================================================
# 🗄️ DATABASE & CACHE: Core data infrastructure

POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# =============================================================================
# 🪣 STORAGE (MinIO / S3)

APPFLOWY_S3_ACCESS_KEY=minioadmin
APPFLOWY_S3_SECRET_KEY=your_secure_minio_password
APPFLOWY_S3_CREATE_BUCKET=true
APPFLOWY_S3_USE_MINIO=true
APPFLOWY_S3_MINIO_URL=http://minio:9000
APPFLOWY_S3_BUCKET=appflowy
APPFLOWY_S3_REGION=us-east-1

# =============================================================================
# 🔐 AUTHENTICATION (GoTrue)

GOTRUE_JWT_SECRET=your_super_secret_jwt_string_min_32_chars
GOTRUE_ADMIN_EMAIL=admin@example.com
GOTRUE_ADMIN_PASSWORD=your_secure_admin_password
GOTRUE_DATABASE_URL=postgres://postgres:your_secure_postgres_password@postgres:5432/postgres

# =============================================================================
# 🚀 APPFLOWY CLOUD WORKERS

APPFLOWY_DATABASE_URL=postgres://postgres:your_secure_postgres_password@postgres:5432/postgres
APPFLOWY_REDIS_URI=redis://redis:6379
