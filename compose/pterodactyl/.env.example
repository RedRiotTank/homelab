# ==========================================
# PTERODACTYL CONFIGURATION
# ==========================================

# --- Image Versions ---
PANEL_VERSION=latest
WINGS_VERSION=latest
MARIADB_VERSION=11
REDIS_VERSION=alpine

# --- System ---
TZ=Europe/Madrid

# --- Panel: Domain & Core Settings ---
# Full HTTPS URL the Panel is reached at (through the reverse proxy). Must match the
# domain configured in Nginx Proxy Manager, or asset links/redirects/cookies will break.
APP_URL=https://pterodactyl.yourdomain.com

# Contact address shown in outgoing system emails and support links.
APP_SERVICE_AUTHOR=admin@yourdomain.com

# Comma-separated list of IPs/CIDRs trusted to set X-Forwarded-* headers. Since this
# stack always sits behind Nginx Proxy Manager, "*" is safe here (NPM is the only
# ingress path - proxy_net is not exposed to the host). Narrow it to NPM's container IP
# if you need to be stricter.
TRUSTED_PROXIES=*

# --- Panel: Database ---
DB_DATABASE=panel
DB_USERNAME=pterodactyl
# Generate with: openssl rand -base64 32
DB_PASSWORD=changeme
# Root password for the MariaDB container itself (not used day-to-day by the Panel).
# Generate with: openssl rand -base64 32
DB_ROOT_PASSWORD=changeme_root

# Length of generated hashids (server/node/user public identifiers). 8 is the upstream default.
HASHIDS_LENGTH=8

# --- Panel: Mail ---
# MAIL_DRIVER=log writes outgoing mail to the Panel's log instead of sending it -
# a reasonable default for a homelab with no SMTP relay. Switch to "smtp" and fill in
# the rest of these to enable real password-reset / notification emails.
MAIL_DRIVER=log
MAIL_FROM=noreply@yourdomain.com
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=true

# --- Panel: Bootstrap Access (optional) ---
# Only relevant if you uncomment the matching `ports:` line in docker-compose.yml for
# local/debug access while proxy_net/NPM isn't wired up yet.
PANEL_PORT=127.0.0.1:8081

# --- Wings: Daemon Identity ---
# UID/GID Wings runs as inside the container; also owns files under WINGS_DATA_DIR.
WINGS_UID=988
WINGS_GID=988
WINGS_USERNAME=pterodactyl

# --- Wings: Network ---
# 8080: Wings daemon API + websocket console/file-manager (Wings terminates its own TLS).
# 2022: SFTP, used directly by game-server file-manager clients (plain TCP, cannot be
# reverse-proxied by Nginx Proxy Manager). Both are published directly to the host.
WINGS_API_PORT=8080
WINGS_SFTP_PORT=2022

# --- Storage: Host Path Mounts ---
# All paths below must exist on CrimsonServer under /opt/compose/pterodactyl before
# first deploy - see README.md "Prerequisite Setup".
DATABASE_DATA_DIR=/opt/compose/pterodactyl/database/data
CACHE_DATA_DIR=/opt/compose/pterodactyl/cache/data
PANEL_VAR_DIR=/opt/compose/pterodactyl/panel/var
PANEL_NGINX_DIR=/opt/compose/pterodactyl/panel/nginx
PANEL_CERTS_DIR=/opt/compose/pterodactyl/panel/certs
PANEL_LOGS_DIR=/opt/compose/pterodactyl/panel/logs
WINGS_ETC_DIR=/opt/compose/pterodactyl/wings/etc
WINGS_LOGS_DIR=/opt/compose/pterodactyl/wings/logs
WINGS_RUN_DIR=/opt/compose/pterodactyl/wings/run

# WINGS_DATA_DIR and WINGS_TMP_DIR are mounted host-path-to-itself in docker-compose.yml
# (NOT remapped to a different in-container path) because Wings uses the host's real
# Docker daemon to spawn game-server containers - the path must be identical on both
# sides of the bind mount. If you change these, update config.yml's `system.data` field
# (and set it again via the Node's "Daemon Server File Directory" setting in the Panel
# UI before generating config.yml) to the SAME value. See README.md "Specific Notes".
WINGS_DATA_DIR=/opt/compose/pterodactyl/wings/data
WINGS_TMP_DIR=/opt/compose/pterodactyl/wings/tmp
