# When deployed through Komodo, set these values in the Stack environment
# instead of creating a .env file on the host.

# Database
POSTGRES_DB="nextcloud"
POSTGRES_USER="nextcloud_user"
POSTGRES_PASSWORD="your_secure_database_password_here"

# Host Paths
NEXTCLOUD_DB_DATA_PATH="/opt/compose/nextcloud/db_data"
NEXTCLOUD_APP_CONFIG_PATH="/opt/compose/nextcloud/app_config"
NEXTCLOUD_DATA_PATH="/srv/nextcloud_data"

# Port Configuration (docker-compose.yml binds it to 127.0.0.1)
NEXTCLOUD_PORT="8282"
