# System
PUID=1000
PGID=1000
TIMEZONE=Europe/Madrid
TZ=Europe/Madrid

# Scheduled library rescan (quick scan).
# Disabled by default: each server decides whether to enable it and with which cron.
# Cron format: minute hour day-of-month month day-of-week (0=Sunday, 4=Thursday).
ENABLE_SCHEDULED_RESCAN=false
SCHEDULED_RESCAN_CRON=0 3 * * *

# Routes
RETRO_DATA_DIR=/opt/compose/romm
# Library generated by build_library.py (symlinks + gamelist + covers)
ROMM_LIBRARY_DIR=/opt/compose/romm/library
# Full rclone mount (community:) on the host
RCLONE_MOUNT_DIR=/mnt/media

# Ports
ROMM_PORT=8082
EMU_WEB_PORT=3001
EMU_BACKEND_PORT=3002

# Secrets and database
DB_NAME=romm
DB_USER=romm-user
DB_PASSWORD=secret_db_password
DB_ROOT_PASSWORD=secret_root_password
ROMM_SECRET_KEY=your_secret_key_here
IGNORE_AUTH=true
STEAMGRIDDB_API_KEY=your_steamgriddb_api_key
ROMM_BASE_URL=https://emu.yourdomain.com

# Leave empty to use only the local metadata/covers from gamelist.xml
SCREENSCRAPER_USER=
SCREENSCRAPER_PASSWORD=
