# =============================================================================
# AppFlowy Cloud - Configuration Template
# =============================================================================
# Copy this file to .env and replace every placeholder before deploying.
# Real values (domains, credentials, SMTP, OAuth secrets) must never be
# committed.

# --- Public URLs -------------------------------------------------------------

APPFLOWY_BASE_URL=https://appflowy.example.com
APPFLOWY_WEBSOCKET_BASE_URL=wss://appflowy.example.com/ws/v2
APPFLOWY_WEB_URL=https://appflowy.example.com

# --- Images ------------------------------------------------------------------
GOTRUE_VERSION=latest
APPFLOWY_CLOUD_VERSION=latest
APPFLOWY_WEB_VERSION=latest
APPFLOWY_WORKER_VERSION=latest

# --- Database and cache ------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
POSTGRES_DB=postgres

APPFLOWY_DATABASE_URL=postgres://postgres:change-me@postgres:5432/postgres
APPFLOWY_REDIS_URI=redis://redis:6379
GOTRUE_DATABASE_URL=postgres://postgres:change-me@postgres:5432/postgres?search_path=auth

APPFLOWY_WORKER_DATABASE_URL=postgres://postgres:change-me@postgres:5432/postgres
APPFLOWY_WORKER_DATABASE_NAME=postgres
APPFLOWY_WORKER_REDIS_URL=redis://redis:6379
APPFLOWY_DATABASE_MAX_CONNECTIONS=40

# --- Object storage (MinIO / S3) --------------------------------------------

APPFLOWY_S3_USE_MINIO=true
APPFLOWY_S3_CREATE_BUCKET=true
APPFLOWY_S3_MINIO_URL=http://minio:9000
APPFLOWY_S3_ACCESS_KEY=minioadmin
APPFLOWY_S3_SECRET_KEY=change-me
APPFLOWY_S3_BUCKET=appflowy
APPFLOWY_S3_REGION=us-east-1
APPFLOWY_S3_PRESIGNED_URL_ENDPOINT=https://appflowy.example.com/minio-api

# --- Authentication (GoTrue) -------------------------------------------------
GOTRUE_ADMIN_EMAIL=admin@example.com
GOTRUE_ADMIN_PASSWORD=change-me
GOTRUE_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
GOTRUE_JWT_EXP=7200
GOTRUE_DISABLE_SIGNUP=false
GOTRUE_MAILER_AUTOCONFIRM=false
GOTRUE_RATE_LIMIT_EMAIL_SENT=100
GOTRUE_MAILER_TEMPLATES_MAGIC_LINK=

# --- Application behaviour ---------------------------------------------------
APPFLOWY_ACCESS_CONTROL=true
GUEST_INVITES_REQUIRE_ADMIN_APPROVAL=false
SIGNUP_WHITELIST_ENABLED=false
APPFLOWY_SEARCH_SERVICE_URL=http://appflowy_search:4002
APPFLOWY_SEARCH_REQUEST_TIMEOUT_SECS=10
RUST_LOG=info

# --- Nginx -------------------------------------------------------------------
# Paths are relative to the stack directory. Absolute paths also work.
APPFLOWY_NGINX_CONF=./nginx/nginx.conf
APPFLOWY_NGINX_SSL_CERT=./nginx/ssl/certificate.crt
APPFLOWY_NGINX_SSL_KEY=./nginx/ssl/private_key.key

# --- External identity providers (optional) ---------------------------------
# Leave disabled unless you configure the matching credentials.
GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=https://appflowy.example.com/gotrue/callback

GOTRUE_EXTERNAL_GITHUB_ENABLED=false
GOTRUE_EXTERNAL_GITHUB_CLIENT_ID=
GOTRUE_EXTERNAL_GITHUB_SECRET=
GOTRUE_EXTERNAL_GITHUB_REDIRECT_URI=https://appflowy.example.com/gotrue/callback

GOTRUE_EXTERNAL_DISCORD_ENABLED=false
GOTRUE_EXTERNAL_DISCORD_CLIENT_ID=
GOTRUE_EXTERNAL_DISCORD_SECRET=
GOTRUE_EXTERNAL_DISCORD_REDIRECT_URI=https://appflowy.example.com/gotrue/callback

GOTRUE_SAML_ENABLED=false
GOTRUE_SAML_PRIVATE_KEY=

# --- AI services (optional) --------------------------------------------------
AI_SERVER_HOST=ai
AI_SERVER_PORT=5001
AI_OPENAI_API_KEY=

ASSEMBLYAI_API_KEY=
ASSEMBLYAI_API_BASE=https://api.assemblyai.com/v2
ASSEMBLYAI_STREAMING_API_BASE=https://streaming.assemblyai.com/v3

# --- Outgoing mail (optional) ------------------------------------------------
# Used by the AppFlowy mailer.
APPFLOWY_MAILER_SMTP_HOST=
APPFLOWY_MAILER_SMTP_PORT=465
APPFLOWY_MAILER_SMTP_USERNAME=
APPFLOWY_MAILER_SMTP_EMAIL=
APPFLOWY_MAILER_SMTP_PASSWORD=
APPFLOWY_MAILER_SMTP_TLS_KIND=none

# Used by GoTrue for confirmation and recovery emails.
GOTRUE_SMTP_HOST=
GOTRUE_SMTP_PORT=465
GOTRUE_SMTP_USER=
GOTRUE_SMTP_PASS=
GOTRUE_SMTP_ADMIN_EMAIL=
GOTRUE_SMTP_MAX_FREQUENCY=1ns
