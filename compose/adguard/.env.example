# ==========================================
# ADGUARD HOME CONFIGURATION
# ==========================================

# --- Network Services (Must remain open to the LAN) ---
# Port 53 handles DNS queries across TCP/UDP
ADGUARD_DNS_PORT=53

# --- Security: Web UI Port Binding ---
# Bind to localhost (127.0.0.1) if exposed via reverse proxy (recommended)
ADGUARD_SETUP_PORT=127.0.0.1:3030
ADGUARD_WEB_PORT=127.0.0.1:8053

# Or expose directly to the local network:
# ADGUARD_SETUP_PORT=3030
# ADGUARD_WEB_PORT=8053
