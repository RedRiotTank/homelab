# ==========================================
# CLOUDFLARE DDNS CONFIGURATION
# ==========================================
# API Token with Zone:DNS:Edit permissions
CF_API_TOKEN=your_cloudflare_api_token_here
CF_ZONE=example.com
CF_PROXIED=false
CF_CRON=*/5 * * * *

# ==========================================
# NGINX PROXY MANAGER PORTS
# ==========================================
# Public routing ports (bind to all interfaces)
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443

# Admin Web UI port binding
# For security, bind ONLY to localhost if accessed via tunnel, VPN, or reverse proxy:
NPM_ADMIN_PORT=127.0.0.1:81
# Or expose to local network:
# NPM_ADMIN_PORT=81
